PORT=5001
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/truspace

# File storage: s3 (AWS S3) or local (backend/uploads)
STORAGE_DRIVER=s3
S3_BUCKET=trust-space
AWS_REGION=ap-south-1
S3_PREFIX=uploads/
# Signed download links stay valid for this many seconds
S3_URL_EXPIRES=3600
# Leave the keys empty to use the standard AWS credential chain (~/.aws/credentials, IAM role on EC2/ECS…)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible services (MinIO, LocalStack); leave empty for AWS
S3_ENDPOINT=

UPLOAD_DIR=uploads

# Sign-in
# Long random secret for signing access tokens — REQUIRED in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_DAYS=1
REMEMBER_DAYS=30
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
RESET_MINUTES=30
# Password for the sample accounts created by `npm run seed` (development only)
SEED_PASSWORD=Trust@1234

# PACE identity-hub provisioning token. The active token lives in a file at the
# backend root (provisioning_token), rotatable from PACE; this is the fallback.
PROVISIONING_TOKEN=

# Outgoing mail (sign-up codes, password resets, account approval). Leave MAIL_HOST empty to log mails instead of sending.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=STARTTLS
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=TruSpace

# Push notifications (Firebase admin SDK service-account JSON, see Firebase console → Service accounts)
FIREBASE_ADMIN_FILE=firebase-admin.json
